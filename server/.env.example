# copy to server/.env and fill in the real values

PORT=3000

# MySQL / MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=joboffers
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=job_offers

# Only for a hosted MySQL that requires TLS. Leave both unset for a local database.
# Point at the ca.pem file when developing, and paste the file's whole contents into
# MYSQL_CA_CERT on a host that has no filesystem to read it from.
# MYSQL_CA_CERT_PATH=./ca.pem
# MYSQL_CA_CERT=

# Lower this on a serverless host, where every instance holds its own pool and a
# free tier database only allows a couple of dozen connections in total.
# MYSQL_CONNECTION_LIMIT=10

# Redis
# Required on a deployed host, where the localhost default below is never right and the
# server refuses to start without it.
#
# A hosted Redis is TLS-only, and node-redis reads TLS from the scheme alone, so the url
# has to start with rediss:// -- with the second s. Upstash's console shows redis:// in
# its redis-cli snippet because the --tls flag beside it carries the TLS; there is no
# such flag here, so add the s by hand. Plain redis:// is refused by the server.
# The https:// address in UPSTASH_REDIS_REST_URL is a different protocol again and this
# server cannot speak to it at all.
REDIS_URL=redis://127.0.0.1:6379

# MongoDB
# MONGO_URL is required on a deployed host for the same reason as REDIS_URL above.
# On Atlas, allow 0.0.0.0/0 under Network Access, because a serverless host has no
# fixed address to add to the list.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DATABASE=job_offers

# Where the React dev server runs, so CORS can allow it
CLIENT_ORIGIN=http://localhost:5173
